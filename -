components:
  schemas:
    AttendanceRecord:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        employee:
          type: integer
        employee_name:
          type: string
          readOnly: true
        date:
          type: string
          format: date
        check_in:
          type: string
          format: date-time
          nullable: true
        check_out:
          type: string
          format: date-time
          nullable: true
        notes:
          type: string
          maxLength: 255
        worked_seconds:
          type: integer
          readOnly: true
      required:
      - date
      - employee
      - employee_name
      - id
      - worked_seconds
    Employee:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        first_name:
          type: string
          maxLength: 100
        last_name:
          type: string
          maxLength: 100
        email:
          type: string
          format: email
          maxLength: 254
        position:
          type: string
          maxLength: 120
        is_active:
          type: boolean
        date_joined:
          type: string
          format: date
          readOnly: true
      required:
      - date_joined
      - email
      - first_name
      - id
      - last_name
    PatchedAttendanceRecord:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        employee:
          type: integer
        employee_name:
          type: string
          readOnly: true
        date:
          type: string
          format: date
        check_in:
          type: string
          format: date-time
          nullable: true
        check_out:
          type: string
          format: date-time
          nullable: true
        notes:
          type: string
          maxLength: 255
        worked_seconds:
          type: integer
          readOnly: true
    PatchedEmployee:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        first_name:
          type: string
          maxLength: 100
        last_name:
          type: string
          maxLength: 100
        email:
          type: string
          format: email
          maxLength: 254
        position:
          type: string
          maxLength: 120
        is_active:
          type: boolean
        date_joined:
          type: string
          format: date
          readOnly: true
  securitySchemes:
    basicAuth:
      type: http
      scheme: basic
    cookieAuth:
      type: apiKey
      in: cookie
      name: sessionid
