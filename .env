# Postgres (used by both services)
POSTGRES_DB=attendance_db
POSTGRES_USER=attendance_user
POSTGRES_PASSWORD=attendance_pass

# Django DB connection (web container)
DB_NAME=attendance_db
DB_USER=attendance_user
DB_PASSWORD=attendance_pass
DB_HOST=db
DB_PORT=5432

# Optional: Django
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace_me_with_random_string